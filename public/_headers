# Security headers for every response. Next copies this file into out/,
# and Workers static assets apply it.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# workers.dev hostnames, including version and preview URLs.
# ccbaylife.com does not match this pattern.
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
